NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/akvisionflow?schema=public"

# Direct (non-pooled) connection used ONLY by Prisma migrations (prisma migrate deploy takes a session-level
# advisory lock, which a PgBouncer pooler such as Neon's "-pooler" host cannot hold reliably -> P1002 timeout).
# Required whenever any prisma migrate/validate command runs. Against a plain local/Docker Postgres it is
# simply the same value as DATABASE_URL. On Neon: DATABASE_URL = the pooled host (...-pooler...), and
# DIRECT_URL = the same string with "-pooler" removed from the host name (Neon dashboard: "Connection pooling" off).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/akvisionflow?schema=public"

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Owner Mobile (Android app) tokens use a longer expiry than the web session,
# since re-typing a password on a phone is more disruptive than on a desktop.
MOBILE_JWT_EXPIRES_IN=30d

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Bootstrap super admin (used only by prisma/seed.js)
SEED_SUPER_ADMIN_EMAIL=superadmin@akvisionflow.com
SEED_SUPER_ADMIN_PASSWORD=change-me-now

# Demo tenant seed (optional, separate from production migrations)
SEED_DEMO_TENANT_NAME=Khalid Eye Clinic
SEED_DEMO_ADMIN_EMAIL=admin@khalideyeclinic.test
SEED_DEMO_ADMIN_PASSWORD=change-me-now

# Optional: Slack/Discord/Mattermost incoming-webhook URL. Server errors and failed backups are posted here.
ALERT_WEBHOOK_URL=

# Public URL of the web app (used in password-reset links). Defaults to the first CORS origin.
APP_URL=

# Business sign-up policy. In production registration is CLOSED unless one of these is set:
#   SIGNUP_INVITE_CODE=<code>  -> registration requires that code
#   SIGNUP_OPEN=true           -> anyone may register
SIGNUP_INVITE_CODE=
SIGNUP_OPEN=

# Optional SMTP for password-reset emails. With no SMTP_HOST, tenant admins issue reset links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Production never uses the mock WhatsApp/push providers (they would report fake "sent"). Set true ONLY on a
# staging server to exercise those features against the mocks.
ALLOW_MOCK_PROVIDERS=

# Database connection pool size per API process (default 25; keep size x processes below PostgreSQL max_connections).
# Or put connection_limit=..&pool_timeout=.. in DATABASE_URL.
DB_POOL_SIZE=
