# Copy this file to android/keystore.properties (never commit the copy - it holds passwords) and fill it in
# with your own release keystore's details.
#
# Generate a keystore (once, then guard it like a password - losing it means you can never publish an update
# to the same Play Store listing again; keep it and these passwords in a password manager or secrets vault,
# with a backup, never in git):
#   keytool -genkeypair -v -keystore release-keystore.jks -alias <your-alias> \
#     -keyalg RSA -keysize 2048 -validity 10950
#
# storeFile is resolved relative to this file's directory (android/).
storeFile=release-keystore.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
